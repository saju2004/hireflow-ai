# ========================================================
# HireFlow AI - Environment Configuration Example
# Copy this file to .env and adjust values for your environment
# ========================================================

# Application Profiles: dev (H2 memory mode) or prod (PostgreSQL)
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# PostgreSQL Database Configuration (required if SPRING_PROFILES_ACTIVE=prod)
POSTGRES_DB=hireflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_here
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/hireflow
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres_password_here

# JWT Security (Must be at least 256 bits / 32 characters in production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# File Storage Configuration
STORAGE_UPLOAD_DIR=./storage/resumes

# Optional External AI Provider (default: deterministic fallback)
# Supported options: deterministic, openai, gemini
AI_PROVIDER=deterministic
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
